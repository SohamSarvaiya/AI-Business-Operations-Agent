# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/business_ops

# --- LLM provider: mock | openai | anthropic | gemini ---
# "mock" bina kisi API key ke chalta hai (rule-based demo model).
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Agent behaviour ---
MAX_ITERATIONS=12
ENABLE_WRITE_TOOLS=false      # true karne par approval-gated restock draft tool on hota hai
CURRENCY=INR
TODAY_OVERRIDE=               # demo/testing ke liye, e.g. 2026-10-29
